{
  // CloudTube Worker configuration.
  //
  // The production deployment is a Worker named "cloudtube" (not a Pages project),
  // so the SPA and its same-origin API are served by worker/index.ts. Static files
  // from the Vite build are exposed through the ASSETS binding and unknown paths
  // fall back to index.html for client-side routing.
  "name": "cloudtube",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Serve the standalone legal pages at their extensionless paths: /privacy
    // resolves to /privacy.html and /tos to /tos.html. This is also the default,
    // but stating it keeps the friendly URLs working if the default ever moves.
    "html_handling": "auto-trailing-slash",
    // Send API calls to the Worker before the asset layer. Without this, /api/* can
    // be answered by the static asset handler (which returns 405 for POST), which is
    // exactly the failure this Worker exists to fix.
    "run_worker_first": ["/api/*"]
  },
  // Observability: Workers Logs, Traces, and real-time Issues. Mirrors the
  // dashboard settings so the local config and production stay in sync.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  // Required by `npx wrangler preview` (branch Previews). The block must exist even
  // when a Preview needs no settings of its own: assets, compatibility_date and
  // placement stay at the top level and are not inherited from here.
  "previews": {}
}
