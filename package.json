{
  "name": "react-example",
  "private": true,
  "version": "0.2.28",
  "type": "module",
  "scripts": {
    "dev": "node scripts/version.mjs && tsx server.ts",
    "start": "node scripts/version.mjs && tsx server.ts",
    "build": "node scripts/version.mjs && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "node scripts/version.mjs && tsc --noEmit",
    "test": "node scripts/version.mjs && tsx --test tests/**/*.test.ts tests/**/*.test.tsx",
    "e2e": "node scripts/version.mjs && playwright test",
    "e2e:proof": "E2E_SHOT_DIR=docs/screenshots node scripts/version.mjs && E2E_SHOT_DIR=docs/screenshots playwright test",
    "version:sync": "node scripts/version.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "deploy:log": "node scripts/deploy.mjs",
    "deploy:prod": "node scripts/deploy.mjs --env production",
    "deploy:preview": "node scripts/deploy.mjs --env preview",
    "deploy": "npm run build && npx --yes wrangler deploy",
    "deploy:dry": "npm run build && npx --yes wrangler deploy --dry-run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
