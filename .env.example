# GEMINI_API_KEY: NOT required. AI summaries run through Firebase AI Logic,
# which keeps the Gemini API key on Google's backend. Enable AI Logic once in
# the Firebase console (the Setup Wizard links straight to it); after that every
# signed-in user gets summaries with no key and no configuration.

# VITE_GEMINI_MODEL: Optional. Overrides the Gemini model the AI summaries use.
# Defaults to gemini-3.8-flash (see src/services/geminiAi.ts). Google retires
# model names over time; if summaries start failing with a 404, set this to a
# name from https://firebase.google.com/docs/ai-logic/models and rebuild.
# VITE_GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
