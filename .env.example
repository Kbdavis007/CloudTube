# GEMINI_API_KEY: NOT required. AI summaries run through Firebase AI Logic,
# which keeps the Gemini API key on Google's backend. Enable AI Logic once in
# the Firebase console (the Setup Wizard links straight to it); after that every
# signed-in user gets summaries with no key and no configuration.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
